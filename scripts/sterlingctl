#!/usr/bin/env bash
# One command for running Sterling, for someone who does not read code.
#
# Every subcommand delegates to machinery that already exists — the preflight
# checks, the safe-mode file, the backup module, the release manifest — rather
# than reimplementing it. `start` never bypasses recovery: it runs `doctor`
# first and refuses on a non-zero exit.
#
# Exit codes are the contract, because a script may read them:
#   0  the thing succeeded, or the state is safe
#   1  it failed, or the state is not safe to trade in
#   2  a check could not be run at all — which is NOT a pass
#  64  the command line was wrong
#  69  the thing being asked for does not exist in this checkout
set -uo pipefail

STERLING_ROOT="${STERLING_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PYTHON="${STERLING_PYTHON:-$STERLING_ROOT/backend/.venv/bin/python}"
[ -x "$PYTHON" ] || PYTHON="$(command -v python3)"
export STERLING_ROOT PYTHON
export STERLING_SAFE_MODE_FILE="${STERLING_SAFE_MODE_FILE:-$STERLING_ROOT/data/safe_mode.json}"
export STERLING_EVIDENCE_DB="${STERLING_EVIDENCE_DB:-$STERLING_ROOT/backend/snapback_observations.db}"
export STERLING_BACKUP_ROOT="${STERLING_BACKUP_ROOT:-$STERLING_ROOT/backups/snapback}"

usage() {
  cat <<'USAGE'
Usage: sterlingctl <command>

  status           what Sterling is doing, and which lanes may open trades
  doctor           run every safety check; non-zero exit means DO NOT TRADE
  start            the eleven-step start; refuses at the first step that is not a pass
  stop [--force]   the five-step stop; refuses to abandon open exposure
  safe on|off      block or allow new trades (off needs --ack)
  reconcile        compare local state against the broker
  backup           take a checksummed backup, with a manifest
  restore-check    restore the latest backup in isolation and verify it
  manifest         show the frozen release identity of all ten lanes
  freeze           write the release manifest for this build
  verify           compare the frozen manifest against what is running
  report [DATE]    daily evidence completeness report (default: today)
  lanes            the ten lanes, their state, and whether they may originate
  evidence-start   whether the forward sample has actually started at zero

  certify          the release certification gate table for this build
  certify attest GATE PASS|FAIL WHO [REF]   record one human-observed gate
  bindings         every broker account binding, and which one is active
  bind declare BROKER HOLDER CLIENT_ID SCOPE DEPLOYMENT [EGRESS_PROFILE]
  bind verify|activate|deactivate BINDING_ID
  migrate          the broker account migration procedure
  continuity       static egress, account binding and the handoff checklist
  shadow [DATE]    per-lane shadow execution report
  permission       why each lane may not send a real-money entry

A doctor exit code of 2 means a check could not be run. That is not a pass.
USAGE
}

run_py() { "$PYTHON" -c "import sys; sys.path.insert(0, '$STERLING_ROOT/backend'); exec(sys.stdin.read())"; }

cmd_status() {
  run_py <<'PY'
from app.core.operator_report import operator_dashboard, render_dashboard

# Without a health reading every component reports "did not report" and the
# system reads RECOVERY_REQUIRED forever. Failing closed is right; showing it
# permanently is how an operator learns to ignore the one line that matters.
try:
    from app.services.snapback_system_health import system_health

    health = system_health()
except Exception as exc:
    health = None
    print(f"(health probes unavailable: {exc}; every component reads as failed)")
    print()

print(render_dashboard(operator_dashboard(health)))
PY
}

cmd_doctor() {
  run_py <<'PY'
import sys
from app.core.operator_report import doctor_from_preflight, lane_doctor_checks
from app.services.snapback_preflight import run_preflight

result = run_preflight()
report = doctor_from_preflight(result.checks, extra=lane_doctor_checks())
for check in report.checks:
    mark = {True: "ok", False: "FAIL", None: "COULD NOT CHECK"}[check.passed]
    print(f"{check.name:<28}{mark}" + (f"   {check.detail}" if check.detail else ""))
print()
if report.safe:
    print("All checks ran and passed.")
else:
    if report.failures:
        print("FAILED: " + ", ".join(c.name for c in report.failures))
    if report.unknowns:
        print("COULD NOT CHECK: " + ", ".join(c.name for c in report.unknowns))
    print("Do not enable new trading until this is clear.")
sys.exit(report.exit_code)
PY
}

case "${1:-}" in
  status)        cmd_status ;;
  doctor)        cmd_doctor ;;
  start)
    # The doctor is step 2 of the sequence itself, so it is not run twice here:
    # running it separately would let the state change between the check and the
    # start, which is the race the single sequence exists to close.
    [ -x "$STERLING_ROOT/scripts/sterling-start" ] || {
      echo "no scripts/sterling-start in this checkout."; exit 69; }
    exec "$STERLING_ROOT/scripts/sterling-start" "${@:2}"
    ;;
  stop)
    [ -x "$STERLING_ROOT/scripts/sterling-stop" ] || {
      echo "no scripts/sterling-stop in this checkout; stop the service directly."; exit 69; }
    exec "$STERLING_ROOT/scripts/sterling-stop" "${@:2}"
    ;;
  evidence-start)
    run_py <<'PY'
import sys

from app.core.authoritative_start import render_start
from app.services.authoritative_start_report import authoritative_start_state

start = authoritative_start_state()
print(render_start(start))
if start.started_clean:
    sys.exit(0)
sys.exit(2 if start.unknowns else 1)
PY
    ;;

  safe)          exec "$STERLING_ROOT/scripts/sterling-safe-mode" "${@:2}" ;;

  reconcile)
    run_py <<'PY'
import asyncio, sys

from app.services.snapback_reconciliation import reconcile_family_account

try:
    snapshot = asyncio.run(reconcile_family_account())
except Exception as exc:
    # An unreachable broker is not a clean book. It is an unknown one, and the
    # operator must read this as "keep new risk blocked", not as a pass.
    print(f"reconcile COULD NOT RUN: {exc}")
    print("Broker state is unknown. Keep new entries blocked.")
    sys.exit(2)

print(f"account   {snapshot.account_id or 'UNBOUND'}")
print(f"observed  {snapshot.observed_at}")
print(f"broker positions   {len(snapshot.broker_positions)}")
print(f"sterling positions {len(snapshot.sterling_positions)}")
print()
if snapshot.clean:
    print("CLEAN: broker and Sterling agree.")
    sys.exit(0)

print("MISMATCH — the broker is the source of truth.")
for m in snapshot.mismatches:
    print(f"  [{m.severity}] {m.code} {m.instrument or ''} "
          f"broker={m.broker_quantity} sterling={m.sterling_quantity} {m.details or ''}")
print()
print("Do not resubmit unknown orders. Resolve state before any new entry.")
sys.exit(1)
PY
    ;;

  backup)
    run_py <<'PY'
import os, sys
from pathlib import Path

from app.core.backup_manifest import create_full_backup, manifest_path

root = Path(os.environ["STERLING_ROOT"])
backup_root = Path(os.environ["STERLING_BACKUP_ROOT"])

try:
    result = create_full_backup(backup_root=backup_root, root=root)
except FileNotFoundError as exc:
    print(str(exc))
    print("Set STERLING_EVIDENCE_DB or STERLING_BACKUP_DATABASES.")
    sys.exit(2)

manifest = result.manifest
rows = sum(sum(c.values()) for c in manifest.row_counts.values())

print(f"backup    {result.directory}")
print(f"databases {', '.join(result.databases)}")
print(f"manifest  {manifest_path(manifest, root)}")
print(f"rows      {rows} across {len(manifest.row_counts)} database(s)")
print(f"release   {manifest.release_tag} ({manifest.release_sha[:12]})")
for name, checksum in sorted(manifest.file_checksums.items()):
    print(f"  {checksum[:16]}  {name}")
if result.missing:
    print()
    print("NOT backed up (declared but absent):")
    for name in result.missing:
        print(f"  {name}")
print()
print("restore_test_status is UNTESTED until `sterlingctl restore-check` passes.")
PY
    ;;

  restore-check)
    run_py <<'PY'
import os, sys
from pathlib import Path

from app.core.backup_manifest import (
    latest_backup_dir,
    prove_restore,
    read_backup_manifest,
    record_restore_proof,
    render_restore_proof,
    write_backup_manifest,
)

root = Path(os.environ["STERLING_ROOT"])
backup_root = Path(os.environ["STERLING_BACKUP_ROOT"])

directory = latest_backup_dir(backup_root)
if directory is None:
    print(f"no backup found under {backup_root}")
    print("A release cannot be handed over without a proved restore.")
    sys.exit(2)

# The restore lands in a temporary directory and is removed afterwards. The
# live databases are never touched by this command.
proof = prove_restore(directory)
print(render_restore_proof(proof))

beside = directory / "manifest.json"
if beside.exists():
    stamped = record_restore_proof(read_backup_manifest(beside), proof)
    write_backup_manifest(stamped, root=root, backup_dir=directory)
    print(f"manifest restore_test_status = {stamped.restore_test_status}")

sys.exit(0 if proof.passed else 1)
PY
    ;;

  manifest)
    run_py <<'PY'
from app.core.release_manifest import build_release_manifest, read_manifest, render_manifest

stored = read_manifest()
if stored is None:
    print("No frozen release manifest. Showing the LIVE build instead.")
    print("Run `sterlingctl freeze` to record it.")
    print()
    print(render_manifest(build_release_manifest()))
else:
    print(render_manifest(stored))
PY
    ;;

  freeze)
    run_py <<'PY'
from app.core.release_manifest import build_release_manifest, render_manifest, write_manifest

manifest = build_release_manifest()
path = write_manifest(manifest=manifest)
print(render_manifest(manifest))
print()
print(f"written to {path}")
if manifest["build"].get("working_tree_clean") is not True:
    print()
    print("WARNING: the working tree is not clean, so this release identity")
    print("describes uncommitted code. Commit before freezing for real.")
PY
    ;;

  verify)
    run_py <<'PY'
import sys

from app.core.release_manifest import read_manifest, verify_manifest

stored = read_manifest()
if stored is None:
    print("No frozen release manifest to verify. Run `sterlingctl freeze`.")
    sys.exit(2)

verdict = verify_manifest(stored)
if verdict.matches:
    print("Release identity matches the frozen manifest.")
    sys.exit(0)

print("RELEASE IDENTITY DRIFT")
for drift in verdict.drift:
    print(f"  {drift}")
for lane in verdict.missing_lanes:
    print(f"  lane missing from the running build: {lane}")
for lane in verdict.unexpected_lanes:
    print(f"  lane present but not in the manifest: {lane}")
print()
if verdict.identity_drift:
    print(f"{len(verdict.identity_drift)} change(s) alter a lane's identity.")
    print("Evidence collected under the old manifest belongs to the OLD identity.")
    print("Do not reassign it. Freeze a new release and start a new sample.")
else:
    print("The build moved but no lane identity changed. Re-freeze to record it.")
sys.exit(1)
PY
    ;;

  report)
    STERLING_REPORT_DATE="${2:-}" run_py <<'PY'
import os
from datetime import date

from app.core.evidence_completeness import (
    build_daily_report,
    load_session_rows,
    render_daily_report,
    verify_source_tables,
)

session_date = os.environ.get("STERLING_REPORT_DATE") or date.today().isoformat()

# A missing evidence database must read as SYSTEM_ERROR, not as a quiet day.
# Constructing the warehouse would CREATE an empty one, and an empty store that
# reports "no signals" is exactly the failure this report exists to catch.
db_path = os.environ.get("STERLING_EVIDENCE_DB", "")
session_row, rows = (None, [])
gaps = []
if not db_path or not os.path.exists(db_path):
    print(f"(evidence database not found: {db_path or 'unset'})")
    print()
    gaps.append("evidence_database_missing")
else:
    try:
        from app.services.snapback_observation_warehouse import (
            SnapbackObservationWarehouse,
        )

        warehouse = SnapbackObservationWarehouse(db_path)
        # A renamed or missing table would otherwise read as a quiet day.
        gaps.extend(verify_source_tables(warehouse))
        session_row, rows, read_gaps = load_session_rows(warehouse, session_date)
        gaps.extend(read_gaps)
    except Exception as exc:
        print(f"(evidence store unreadable: {exc})")
        print()
        gaps.append(f"evidence_store_unreadable:{type(exc).__name__}")

report = build_daily_report(
    session_date=session_date,
    session_row=session_row,
    evidence_rows=rows,
    extra_gap_codes=gaps,
)
print(render_daily_report(report))
PY
    ;;

  lanes)
    run_py <<'PY'
from app.core.lane_registry import LANES, may_originate

print(f"{'lane':<28}{'state':<14}{'trades?':<9}why")
for key, lane in LANES.items():
    decision = may_originate(lane.strategy_id, lane.mode)
    allowed = "yes" if decision.allowed else "no"
    why = decision.reason if not decision.allowed else ""
    detail = f" - {decision.detail}" if (why and decision.detail) else ""
    print(f"{key:<28}{lane.state.value:<14}{allowed:<9}{why}{detail}")
print()
print("A lane that may not originate is not broken. It has not earned a sample.")
PY
    ;;

  certify)
    if [ "${2:-}" = "attest" ]; then
      STERLING_GATE="${3:-}" STERLING_STATUS="${4:-}" STERLING_WHO="${5:-}" \
      STERLING_REF="${6:-}" run_py <<'PY'
import os, sys

from app.core.release_manifest import runtime_sha
from app.services.release_certification import CertificationStore

gate, status, who = (
    os.environ.get("STERLING_GATE", ""),
    os.environ.get("STERLING_STATUS", ""),
    os.environ.get("STERLING_WHO", ""),
)
if not (gate and status and who):
    print("usage: sterlingctl certify attest GATE PASS|FAIL WHO [EVIDENCE_REF]")
    sys.exit(64)

sha = runtime_sha()
try:
    result = CertificationStore().attest(
        sha, gate, status, attested_by=who, evidence_ref=os.environ.get("STERLING_REF", "")
    )
except (KeyError, ValueError) as exc:
    print(str(exc))
    sys.exit(64)

print(f"{result.key} = {result.status} for {sha[:12]}, attested by {result.attested_by}")
print("This attestation applies to this SHA only. Any code change voids it.")
PY
      exit $?
    fi
    run_py <<'PY'
import sys

from app.services.release_certification import certification_report, render_certification

report = certification_report()
print(render_certification(report))
sys.exit(0 if report.release_ready else 1)
PY
    ;;

  bindings)
    run_py <<'PY'
import sys

from app.core.broker_account_binding import BindingError
from app.services.account_binding_service import AccountBindingStore

try:
    bindings = AccountBindingStore().all()
except BindingError as exc:
    print(f"account bindings unreadable: {exc}")
    sys.exit(2)

if not bindings:
    print("No broker account binding is declared.")
    print("Sterling cannot place any order, and reconciliation has no account.")
    print("Declare one with: sterlingctl bind declare ...")
    sys.exit(1)

print(f"{'binding':<34}{'status':<14}{'holder':<22}scope")
for binding in bindings:
    print(f"{binding.binding_id:<34}{binding.status.value:<14}"
          f"{binding.legal_account_holder:<22}{binding.account_scope}")
print()
print("Retired bindings stay listed: their fills are never reassigned.")
PY
    ;;

  bind)
    STERLING_BIND_ACTION="${2:-}" STERLING_A="${3:-}" STERLING_B="${4:-}" \
    STERLING_C="${5:-}" STERLING_D="${6:-}" STERLING_E="${7:-}" STERLING_F="${8:-}" \
    run_py <<'PY'
import os, sys

from app.core.broker_account_binding import BindingError
from app.services.account_binding_service import AccountBindingStore

action = os.environ.get("STERLING_BIND_ACTION", "")
store = AccountBindingStore()
args = [os.environ.get(f"STERLING_{k}", "") for k in ("A", "B", "C", "D", "E", "F")]

try:
    if action == "declare":
        broker, holder, client_id, scope, deployment, egress = args
        if not all([broker, holder, client_id, scope, deployment]):
            print("usage: sterlingctl bind declare BROKER HOLDER CLIENT_ID SCOPE "
                  "DEPLOYMENT [EGRESS_PROFILE]")
            sys.exit(64)
        binding = store.declare(
            broker=broker,
            legal_account_holder=holder,
            client_id=client_id,
            account_scope=scope,
            deployment_id=deployment,
            static_egress_profile=egress,
        )
        print(f"declared {binding.binding_id} ({binding.status.value})")
        print("It cannot trade until it is verified and activated.")
    elif action in ("verify", "activate", "deactivate"):
        binding_id = args[0]
        if not binding_id:
            print(f"usage: sterlingctl bind {action} BINDING_ID")
            sys.exit(64)
        binding = getattr(store, action)(binding_id)
        print(f"{binding.binding_id} is now {binding.status.value}")
        if action == "deactivate":
            print("Its fills keep its own evidence segment. They are never reassigned.")
    else:
        print("usage: sterlingctl bind declare|verify|activate|deactivate ...")
        sys.exit(64)
except BindingError as exc:
    print(str(exc))
    sys.exit(1)
PY
    ;;

  migrate)
    run_py <<'PY'
from app.services.account_binding_service import render_migration_procedure

print(render_migration_procedure())
PY
    ;;

  continuity)
    run_py <<'PY'
import sys

from app.services.continuity_doctor import continuity_report, render_continuity

report = continuity_report()
print(render_continuity(report))
sys.exit(0 if report.handoff_ready else 1)
PY
    ;;

  shadow)
    STERLING_SHADOW_DATE="${2:-}" run_py <<'PY'
import os

from app.services.shadow_execution import shadow_report

date = os.environ.get("STERLING_SHADOW_DATE") or ""
print(shadow_report([date] if date else None))
PY
    ;;

  permission)
    run_py <<'PY'
from app.services.capital_permission_report import render_permissions

print(render_permissions())
PY
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $1"; echo; usage; exit 64 ;;
esac
