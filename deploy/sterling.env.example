# Sterling — family deployment environment file (TEMPLATE)
#
# Copy this to a path OUTSIDE the repository and fill it in:
#
#   mkdir -p ~/.config/sterling
#   install -m 600 deploy/sterling.env.example ~/.config/sterling/sterling.env
#   ${EDITOR:-nano} ~/.config/sterling/sterling.env
#
# Mode 600 matters: this file holds the Kite API secret. It is read by the
# systemd unit's EnvironmentFile= directive. NEVER commit a filled-in copy — a
# secret in git history survives every later deletion and reaches anyone who
# clones the repository.
#
# ─────────────────────────────────────────────────────────────────────────────
# WHAT THIS FILE CANNOT DO
#
# It cannot log you in. Zerodha requires a human at the TOTP/2FA step every
# trading day, by design, and no value placed here changes that. What this file
# does is make everything either side of that step unattended: the account is
# provisioned, the config is loaded, the evidence database is bound and the
# runner is started with nothing typed. You perform the Kite login yourself
# before 09:15 IST; the token is then kept alive by the session keeper for as
# long as Zerodha allows.
# ─────────────────────────────────────────────────────────────────────────────


# ── Encryption key ───────────────────────────────────────────────────────────
# The Kite API secret and access token are stored encrypted in the local
# database, under THIS key. Leave it unset and the code falls back to a
# published dev key, which means the stored secret is encrypted with a value
# anyone reading the source already knows. Generate one per machine:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STERLING_SECRET_KEY=<generate one; see above>


# ── Kite (Zerodha) ───────────────────────────────────────────────────────────
# Adopted at startup by auth.seed_from_env(), so a fresh machine or a wiped
# database boots already provisioned — no retyping credentials into the UI.
KITE_API_KEY=<your kite api key>
KITE_API_SECRET=<your kite api secret>

# The Sterling user the account is attached to. Leave as "default" unless you
# run more than one operator on this machine.
KITE_APP_USER_ID=default
KITE_LABEL=Family

# true = paper. The Snapback prospective runtime is paper-only and its promotion
# gate refuses live execution regardless of this flag, but setting it honestly
# keeps the UI from claiming something the runtime will not do.
KITE_PAPER=true

# Optional, and usually left empty. One access token from a browser login. It is
# only adopted when no live token is stored, so a stale value here can never
# clobber the token you obtained this morning. Treat it as a secret.
KITE_ACCESS_TOKEN=


# ── Snapback runtime identity ────────────────────────────────────────────────
# The build the operator declares they are running. Startup compares it against
# the repository's actual HEAD and halts on a mismatch, so evidence can never be
# attributed to a build that did not produce it.
STERLING_EXPECTED_BUILD_SHA=<git rev-parse HEAD>

# Pinned to the historical strategy freeze, not to HEAD. It identifies what
# Snapback decides, which has not changed since snapback-prospective-freeze-1.0.
STERLING_RUNTIME_SHA=9e989dd910995deb5e77385b983e5992c58883c0

# Stamped into the database's evidence_meta row. Preflight refuses to start
# against a file belonging to a different experiment.
STERLING_EXPERIMENT_ID=prospective_runtime_1_3
STERLING_ALLOCATION_CAPITAL_INR=1000000

# When this experiment's authoritative sample begins. Signals whose bar closed
# before this moment are recorded as replay, never as prospective evidence.
# Without it that rule cannot fire at all, and the only thing keeping an older
# signal out of the sample is the single-session recency check. Set it to the
# first session you intend to collect, with an explicit timezone.
STERLING_DATASET_START=2026-09-17T00:00:00+05:30


# ── Paths ────────────────────────────────────────────────────────────────────
STERLING_OBSERVATIONS_DB_PATH=/home/<user>/Sterling/data/snapback/prospective_runtime_1_2.db
STERLING_SNAPBACK_BACKUP_ROOT=/home/<user>/Sterling/backups/snapback
STERLING_FORWARD_REPORT_ROOT=/home/<user>/Sterling/artifacts/snapback_forward
STERLING_POST_MARKET_STATE_PATH=/home/<user>/Sterling/data/snapback/post_market_ops_state.json
STERLING_FREEZE_RECORD_PATH=docs/strategy/snapback/PROSPECTIVE_FREEZE_RECORD.md
STERLING_NEW_TRADES_HALT_PATH=/home/<user>/Sterling/data/snapback/new_trades_halted.json


# ── Family Mode ──────────────────────────────────────────────────────────────
# One strategy, one account. With this on, every other auto-runner stays stopped
# and the broker write guard refuses every exposure-increasing mutation.
STERLING_FAMILY_MODE=true

# The exact account the runtime is allowed to touch. Without both of these the
# system would fall back to whichever account happens to be connected, which is
# somebody else's money. These are identifiers, not secrets, but they are
# machine-specific, so they live here rather than in the repository.
STERLING_FAMILY_USER_ID=<sterling user id>
STERLING_FAMILY_ACCOUNT_ID=<kite account id, e.g. KITE-XXXXXXXX>


# ── Network ──────────────────────────────────────────────────────────────────
# Loopback. Changing this to 0.0.0.0 puts an authenticated broker session on
# every device on the home network.
STERLING_BIND_HOST=127.0.0.1


# ── Alerts (optional) ────────────────────────────────────────────────────────
# Without a target the alert outbox still records every alert; it just reports
# them as undelivered rather than pretending they were sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── Preflight thresholds (optional; the defaults are usually right) ───────────
# STERLING_MIN_FREE_DISK_BYTES=2147483648
# Set only on a machine whose clock is disciplined by something timedatectl
# cannot see. An unsynchronised clock makes every quote freshness test wrong.
# STERLING_SKIP_CLOCK_CHECK=
