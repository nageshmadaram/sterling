# Sterling — family deployment environment file (TEMPLATE)
#
# Copy this to a path OUTSIDE the repository and fill it in:
#
#   mkdir -p ~/.config/sterling
#   install -m 600 deploy/sterling.env.example ~/.config/sterling/sterling.env
#   ${EDITOR:-nano} ~/.config/sterling/sterling.env
#
# Mode 600 matters: this file holds the Kite API secret. It is read by the
# systemd unit's EnvironmentFile= directive. NEVER commit a filled-in copy.
#
# WHAT THIS FILE CANNOT DO
# Zerodha requires a human at the TOTP/2FA step every trading day. Perform the
# Kite login yourself before the market session; this file cannot automate it.

# ── Encryption key ───────────────────────────────────────────────────────────
# Generate one per machine:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STERLING_SECRET_KEY=<generate one; see above>

# ── Kite (Zerodha) ───────────────────────────────────────────────────────────
KITE_API_KEY=<your kite api key>
KITE_API_SECRET=<your kite api secret>
KITE_APP_USER_ID=default
KITE_LABEL=Family

# Runtime 1.6 prospective operation remains paper/shadow until the economic
# promotion gate passes. Keep this true while collecting Track-A evidence.
KITE_PAPER=true
KITE_ACCESS_TOKEN=

# ── Snapback runtime identity ────────────────────────────────────────────────
# Startup compares this exact build against repository HEAD and halts on mismatch.
STERLING_EXPECTED_BUILD_SHA=<git rev-parse HEAD>

# Strategy identity remains the historical frozen strategy, not the runtime
# engineering release. Do not change it for runtime-only evidence fixes.
STERLING_RUNTIME_SHA=9e989dd910995deb5e77385b983e5992c58883c0

# No code path is allowed to invent an experiment id. Keep one explicit identity
# for the entire prospective sample unless you deliberately start a new experiment.
STERLING_EXPERIMENT_ID=prospective_runtime_1_6
STERLING_ALLOCATION_CAPITAL_INR=1000000

# CRITICAL: do NOT set this to merge day. Set it only after the runtime-1.6 live
# acceptance artifact has genuinely passed, to the first market session whose
# evidence you intend to count. Use an explicit timezone. Anything before this
# boundary is diagnostic/shadow evidence and must not enter Track A.
STERLING_DATASET_START=<first accepted session, e.g. 2026-09-18T00:00:00+05:30>

# ── Paths ────────────────────────────────────────────────────────────────────
STERLING_OBSERVATIONS_DB_PATH=/home/<user>/Sterling/data/snapback/prospective_runtime_1_6.db
STERLING_SNAPBACK_BACKUP_ROOT=/home/<user>/Sterling/backups/snapback
STERLING_FORWARD_REPORT_ROOT=/home/<user>/Sterling/artifacts/snapback_forward
STERLING_POST_MARKET_STATE_PATH=/home/<user>/Sterling/data/snapback/post_market_ops_state.json
STERLING_FREEZE_RECORD_PATH=docs/strategy/snapback/PROSPECTIVE_FREEZE_RECORD.md
STERLING_NEW_TRADES_HALT_PATH=/home/<user>/Sterling/data/snapback/new_trades_halted.json
STERLING_SAFE_MODE_FILE=/home/<user>/Sterling/data/safe_mode.json

# ── Family Mode ──────────────────────────────────────────────────────────────
# One strategy, one bound account. Other auto-runners stay stopped and broker
# write guards refuse exposure-increasing mutations outside the admitted system.
STERLING_FAMILY_MODE=true
STERLING_FAMILY_USER_ID=<sterling user id>
STERLING_FAMILY_ACCOUNT_ID=<kite account id, e.g. KITE-XXXXXXXX>

# ── Network ──────────────────────────────────────────────────────────────────
# Loopback only. Do not expose an authenticated broker session to the LAN.
STERLING_BIND_HOST=127.0.0.1

# ── Alerts (optional) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Preflight thresholds (optional) ─────────────────────────────────────────
# STERLING_MIN_FREE_DISK_BYTES=2147483648
# STERLING_SKIP_CLOCK_CHECK=
