ENVIRONMENT=development
PAPER_TRADING=true
REAL_PUBLIC_DATA=true
DEFAULT_UNDERLYING=NIFTY
EXCHANGE_ADAPTER=zerodha
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_CONTRACTS=10
MAX_POSITION_PCT=0.05
DEFAULT_CAPITAL=100000.0
# Exchange credentials (optional — public data works without keys)
DELTA_API_KEY=
DELTA_API_SECRET=

# Zerodha Kite (optional — used by add_kite.py / Kite integration)
# Set these and the backend provisions the Kite account at boot, so a fresh DB or
# a new machine never needs credentials retyped into the UI.
KITE_API_KEY=
KITE_API_SECRET=
# Aliases accepted by add_kite.py and by the boot-time seeding:
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
#
# Optional: skip the interactive login entirely on a dev restart. Paste the
# access_token from one browser login and the process comes up connected.
# Zerodha invalidates every token at 06:00 IST, so this value goes stale daily —
# it is only ever adopted when the stored token is absent or already past its
# window, so a login done through the browser today is never overwritten by it.
# KITE_ACCESS_TOKEN=
#
# Which app user the seeded account belongs to, and how it presents itself.
# KITE_APP_USER_ID=default
# KITE_LABEL=Kite (env)
# KITE_PAPER=true

# Sterling DB
STERLING_DB_PATH=sterling_paper.db

# Phase 1 — Trading mode
STERLING_DEFAULT_MODE=swing

# Phase 5 — Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 6 — Circuit breakers
STERLING_DAILY_LOSS_LIMIT=0.05
STERLING_MARGIN_FLOOR=0.20
STERLING_MAX_CONSECUTIVE_LOSSES=5

# v3 — Drawdown circuit breaker
STERLING_DD_WARN=0.05
STERLING_DD_HALT=0.10
STERLING_DD_RESET=0.15

# v3 — Correlation penalty thresholds
STERLING_CORR_PENALTY_HIGH=0.8
STERLING_CORR_PENALTY_MED=0.6

# v3 — Walk-forward engine defaults
STERLING_WF_TRAIN_BARS=180
STERLING_WF_TEST_BARS=60

# v3 — Sensitivity analysis
STERLING_SENSITIVITY_STALE_DAYS=7

# Snapback prospective evidence database (absolute path recommended)
STERLING_OBSERVATIONS_DB_PATH=data/snapback/prospective_freeze_1.db
STERLING_RUNTIME_SHA=9e989dd910995deb5e77385b983e5992c58883c0
STERLING_SNAPBACK_BACKUP_ROOT=backups/snapback
STERLING_FORWARD_REPORT_ROOT=artifacts/snapback_forward
STERLING_POST_MARKET_STATE_PATH=data/snapback/post_market_ops_state.json
STERLING_FREEZE_RECORD_PATH=docs/strategy/snapback/PROSPECTIVE_FREEZE_RECORD.md
STERLING_NEW_TRADES_HALT_PATH=data/snapback/new_trades_halt.json
